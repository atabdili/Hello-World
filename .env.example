# Citibank API credentials
# Obtain from https://developer.citi.com after registering an application
CITI_CLIENT_ID=your_client_id_here
CITI_CLIENT_SECRET=your_client_secret_here
CITI_REDIRECT_URI=https://your-app.example.com/callback

# Citibank account to use for payments
# Must be a checking account under the authenticated user
CITI_ACCOUNT_ID=your_checking_account_id_here

# API environment: "sandbox" or "production"
CITI_ENV=sandbox
